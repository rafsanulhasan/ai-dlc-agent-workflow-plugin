{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "ai-dlc:orchestrator",
  "effortLevel": "medium",
  "env": {
    "ANTHROPIC_MODEL": "opus",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp"
  },
  "permissions": {
    "allow": [
      "Bash(git --version)",
      "Bash(git status)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(node tools/build-copilot.mjs)",
      "Bash(node tools/build-copilot.mjs --check)",
      "Bash(npx -y @anthropic-ai/claude-code plugin validate --strict ./plugins/claude/ai-dlc)",
      "Bash(npx -y @anthropic-ai/claude-code plugin validate --strict .)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-copilot-stale.mjs",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-workflow.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.mjs\" --root \".worktrees\"",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-remove.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true,
    "cache-keepalive@ai-dlc-agent-workflow": true
  },
  "extraKnownMarketplaces": {
    "ai-dlc-agent-workflow": {
      "source": {
        "source": "github",
        "repo": "rafsanulhasan/ai-dlc-agent-workflow-plugin"
      }
    }
  }
}
