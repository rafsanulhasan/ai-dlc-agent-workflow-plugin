{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "ai-dlc:orchestrator",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet --version)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet stryker:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet add package:*)",
      "Bash(dotnet add reference:*)",
      "Bash(dotnet remove package:*)",
      "Bash(dotnet remove reference:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet list reference:*)",
      "Bash(node --version)",
      "Bash(npx tsc:*)",
      "Bash(npx stryker:*)",
      "Bash(npx vitest:*)",
      "Bash(npx jest:*)",
      "Bash(npx mocha:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx biome:*)",
      "Bash(npm --version)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(pnpm --version)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(yarn --version)",
      "Bash(yarn test:*)",
      "Bash(yarn run:*)",
      "Bash(yarn install:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(yarn why:*)",
      "Bash(bun --version)",
      "Bash(bun test:*)",
      "Bash(bun run:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx stryker:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
