{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "{{STRYKER_TEST_RUNNER}}",
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "mutate": [
    "{{SOURCE_ROOT}}/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "!{{SOURCE_ROOT}}/**/*.{test,spec}.*",
    "!{{SOURCE_ROOT}}/**/__tests__/**",
    "!{{SOURCE_ROOT}}/**/*.d.ts"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": {{MUTATION_BREAK}} }
}
